# Copy this file to ".env" and fill it in yourself. Never share .env or paste it in a chat.
# On GitHub the same names go in Settings -> Secrets and variables -> Actions (the repository is public:
# secrets stay hidden, nothing here may ever be written in a file of the repository).

# Zernio dashboard -> API keys -> Create API key (starts with sk_)
ZERNIO_API_KEY=paste-your-key-here

# pixabay.com/api/docs -> log in, your free key is shown on that page
PIXABAY_API_KEY=paste-your-key-here

# Telegram alerts: token from @BotFather (the same bot as the other channels works)
TELEGRAM_BOT_TOKEN=paste-your-key-here

# your Telegram chat id (same as the other channels): kept secret here because this repository is public
TELEGRAM_CHAT_ID=paste-your-chat-id-here
